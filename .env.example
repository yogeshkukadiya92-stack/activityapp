NODE_ENV=production
PORT=8787
PUBLIC_ORIGIN=https://live.example.com
TRUST_PROXY=true

# PostgreSQL is required in production.
DATABASE_URL=postgresql://cfl_live:replace-me@postgres:5432/cfl_live
DATABASE_SSL=disable
DATABASE_POOL_SIZE=10

# Redis enables multi-instance WebSocket events and distributed rate limiting.
REDIS_URL=redis://redis:6379

# Used once to create the initial organization admin. Enable the optional starter workshop only for onboarding environments.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_NAME=CFL Administrator
ORGANIZATION_NAME=Coach For Life
ORGANIZATION_SLUG=coach-for-life
BOOTSTRAP_WORKSHOP=false
BOOTSTRAP_DEMO_DATA=false

# Optional release label surfaced by /api/health and /api/ready.
SOURCE_COMMIT=

# Optional when the browser and API use different public origins.
VITE_API_BASE=
VITE_WS_BASE=
